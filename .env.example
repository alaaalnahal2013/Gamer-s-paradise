# GAMER'S PARADISE • ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your Supabase credentials:

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=

# Supabase anon / public API key (from Project Settings -> API)
SUPABASE_KEY=

# Optional: Port configuration
PORT=8000
HOST=127.0.0.1
